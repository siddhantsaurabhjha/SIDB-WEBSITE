---
import Icon from './Icon.astro';
import { shieldDetails } from '../data/features';
---

<section id="shield" class="py-20 md:py-32 border-t border-white/[0.08] relative overflow-hidden">
  
  <!-- Subtle Shield Ambient Backlight -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="w-[500px] h-[300px] bg-blue-600/10 rounded-full blur-[140px] opacity-60"></div>
    <div class="w-[400px] h-[250px] bg-violet-600/10 rounded-full blur-[120px] opacity-50"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Shield Header -->
    <div class="max-w-3xl mb-16">
      <div class="badge-pill mb-3">
        <Icon name="shield-check" size={12} class="w-3 h-3 text-violet-400" />
        <span>Native Protection Layer</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        SIDB Shield: Clean, Private Browsing Without External Bloat
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300/90 leading-relaxed">
        Rather than relying on heavy third-party extensions, SIDB Shield is integrated directly into the browser's network request pipeline. It intercepts tracking requests, stops banner ads, and protects your attention before page contents render.
      </p>
    </div>

    <!-- Shield Architecture Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {shieldDetails.pillars.map((pillar) => (
        <div class="glass-card rounded-2xl p-6 sm:p-8 relative overflow-hidden group">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/25 flex items-center justify-center text-blue-400 shrink-0 mt-0.5 group-hover:border-blue-500/40 transition-colors">
              <Icon name="shield" size={20} class="w-5 h-5" />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white tracking-tight">
                {pillar.title}
              </h3>
              <p class="mt-2 text-sm text-slate-300/80 leading-relaxed">
                {pillar.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Shield Transparency & Boundaries Notice -->
    <div class="mt-10 rounded-2xl bg-white/[0.02] border border-white/[0.08] p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-5 border-b border-white/[0.06]">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
            <Icon name="info" size={18} class="w-4 h-4" />
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white">Realistic Privacy & Protection Boundaries</h4>
            <p class="text-xs text-slate-400">Our engineering commitments and honest limitations</p>
          </div>
        </div>
        <span class="text-[11px] font-mono text-slate-400 px-2.5 py-1 rounded bg-white/[0.04]">Transparency First</span>
      </div>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {shieldDetails.transparencyPoints.map((point) => (
          <div class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300/85 leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500 shrink-0 mt-2"></span>
            <span>{point}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
