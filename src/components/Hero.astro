---
import Icon from './Icon.astro';
import { siteConfig } from '../data/config';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  
  <!-- Subtle background ambient illumination -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="w-[600px] h-[350px] bg-indigo-600/10 rounded-full blur-[140px] opacity-70"></div>
    <div class="w-[450px] h-[250px] bg-blue-500/10 rounded-full blur-[120px] opacity-60 translate-y-24"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header / Copy -->
    <div class="max-w-3xl mx-auto text-center space-y-6">
      
      <!-- Version & Status Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.09] text-xs font-medium text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-white font-semibold">SIDB v0.1.0</span>
        <span class="text-slate-500">•</span>
        <span>Windows & Linux Desktop</span>
        <span class="text-slate-500">•</span>
        <span class="text-indigo-400 font-mono text-[11px]">Chromium 156</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white leading-[1.12]">
        A Browser Built <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent">
          Around You.
        </span>
      </h1>

      <!-- Supporting Copy -->
      <p class="text-base sm:text-lg md:text-xl text-slate-300/90 leading-relaxed max-w-2xl mx-auto font-normal">
        Meet SIDB — a modern desktop browser designed around speed, control, and a cleaner browsing experience.
      </p>

      <!-- CTA Buttons -->
      <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
        <a
          href={siteConfig.downloads.windows.downloadUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-600/25 hover:shadow-indigo-600/35 border border-indigo-400/30 transition-all duration-150 group"
        >
          <Icon name="download" size={18} class="w-4 h-4 text-white group-hover:-translate-y-0.5 transition-transform" />
          <span>Download SIDB (v0.1.0)</span>
        </a>

        <a
          href="#showcase"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl text-sm font-medium text-slate-200 bg-white/[0.05] hover:bg-white/[0.09] border border-white/[0.1] hover:border-white/[0.2] transition-all duration-150"
        >
          <span>Explore the Browser</span>
          <Icon name="arrow-right" size={16} class="w-4 h-4 text-slate-400" />
        </a>
      </div>

      <!-- Technical Trust Micro-Details -->
      <div class="pt-1 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-400 font-normal">
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          Portable ZIP (Windows x64)
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          Native Linux (.deb / .rpm)
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          Zero Telemetry by Default
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          Open Source on GitHub
        </span>
      </div>

    </div>

    <!-- Authentic Product Screenshot Centerpiece -->
    <div class="mt-12 sm:mt-16 relative mx-auto max-w-6xl">
      
      <!-- Restrained Glass Browser Frame -->
      <div class="browser-frame group relative">
        
        <!-- Mock Browser Titlebar / Header -->
        <div class="h-10 px-4 bg-[#0a0d14] border-b border-white/[0.08] flex items-center justify-between select-none">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56]/80 border border-[#e0443e]/50 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]/80 border border-[#dea123]/50 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f]/80 border border-[#1aab29]/50 inline-block"></span>
            <span class="ml-2 text-[11px] text-slate-400 font-mono flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
              SIDB Desktop — New Tab
            </span>
          </div>
          
          <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded-md bg-white/[0.04] border border-white/[0.06] text-[11px] text-slate-400 font-mono">
            <span>sidb://newtab</span>
          </div>

          <div class="flex items-center gap-2 text-slate-500 text-xs">
            <span class="hidden md:inline text-[11px] font-mono">v0.1.0</span>
          </div>
        </div>

        <!-- High-Resolution Authentic Screenshot -->
        <div class="relative bg-[#07080b] overflow-hidden">
          <img
            src="/assets/screenshots/s1.png"
            alt="SIDB Browser official New Tab interface showcasing dark theme, customized shortcuts, and search"
            width="1903"
            height="1026"
            class="w-full h-auto object-cover block"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Subtle Caption Bar -->
      <div class="mt-3 flex items-center justify-between px-2 text-xs text-slate-400">
        <span>Authentic screenshot of SIDB Browser v0.1.0 running on Windows 11</span>
        <a href="#showcase" class="text-indigo-400 hover:text-indigo-300 inline-flex items-center gap-1 transition-colors">
          View all screens
          <Icon name="chevron-right" size={14} class="w-3.5 h-3.5" />
        </a>
      </div>

    </div>

  </div>
</section>

