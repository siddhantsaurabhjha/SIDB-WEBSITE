---
import { siteConfig } from '../data/config';
---

<section id="requirements" class="py-20 md:py-28 border-t border-white/[0.08] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-14">
      <div class="badge-neutral mb-3">Compatibility</div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        System Requirements
      </h2>
      <p class="mt-4 text-base text-slate-300/90 leading-relaxed">
        SIDB is lightweight and built directly for modern 64-bit desktop operating systems.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Windows Requirements Card -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-white/[0.06]">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span>Microsoft Windows</span>
          </h3>
          <span class="text-xs font-mono text-indigo-400 bg-indigo-500/10 px-2.5 py-1 rounded border border-indigo-500/20">
            x86-64
          </span>
        </div>

        <dl class="space-y-4 text-sm">
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Operating System</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.windows.os}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Processor</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.windows.cpu}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Memory</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.windows.ram}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Disk Space</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.windows.storage}</dd>
          </div>
          <div class="pt-2">
            <dt class="text-xs text-slate-400 mb-1">Notes</dt>
            <dd class="text-xs text-slate-300/80 leading-relaxed">{siteConfig.requirements.windows.notes}</dd>
          </div>
        </dl>
      </div>

      <!-- Linux Requirements Card -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-white/[0.06]">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span>Linux Distributions</span>
          </h3>
          <span class="text-xs font-mono text-indigo-400 bg-indigo-500/10 px-2.5 py-1 rounded border border-indigo-500/20">
            glibc 2.35+
          </span>
        </div>

        <dl class="space-y-4 text-sm">
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Distributions</dt>
            <dd class="text-white font-medium text-right sm:max-w-xs">{siteConfig.requirements.linux.os}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Processor</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.linux.cpu}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Memory</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.linux.ram}</dd>
          </div>
          <div class="flex flex-col sm:flex-row sm:justify-between py-2 border-b border-white/[0.04]">
            <dt class="text-slate-400">Disk Space</dt>
            <dd class="text-white font-medium">{siteConfig.requirements.linux.storage}</dd>
          </div>
          <div class="pt-2">
            <dt class="text-xs text-slate-400 mb-1">Notes</dt>
            <dd class="text-xs text-slate-300/80 leading-relaxed">{siteConfig.requirements.linux.notes}</dd>
          </div>
        </dl>
      </div>

    </div>

  </div>
</section>
