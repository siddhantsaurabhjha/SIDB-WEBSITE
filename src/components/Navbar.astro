---
import Icon from './Icon.astro';
import { siteConfig } from '../data/config';

interface Props {
  currentPath?: string;
}

const navLinks = [
  { name: 'Browser', href: '#showcase' },
  { name: 'Features', href: '#features' },
  { name: 'Shield', href: '#shield' },
  { name: 'Requirements', href: '#requirements' },
  { name: 'About', href: '#about' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#07080b]/80 border-b border-white/[0.08] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-18">
      
      <!-- Brand Logo & Wordmark -->
      <a href="/" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg p-1" aria-label="SIDB Browser Home">
        <div class="relative w-9 h-9 rounded-xl overflow-hidden bg-white/5 border border-white/10 flex items-center justify-center p-0.5 shadow-sm group-hover:border-indigo-500/50 transition-colors">
          <img 
            src="/assets/brand/logo.png" 
            alt="SIDB Logo" 
            width="36" 
            height="36" 
            class="w-full h-full object-contain"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-base font-semibold tracking-wider text-white flex items-center gap-1.5">
            SIDB
            <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">v0.1.0</span>
          </span>
          <span class="text-[11px] text-slate-400 font-normal hidden sm:inline -mt-0.5">Desktop Browser</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="hover:text-white transition-colors duration-150 py-1"
          >
            {link.name}
          </a>
        ))}
        
        <a 
          href={siteConfig.links.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="flex items-center gap-1.5 text-slate-300 hover:text-white transition-colors duration-150 py-1"
          aria-label="SIDB GitHub Repository"
        >
          <Icon name="github" size={16} class="w-4 h-4 text-slate-400" />
          <span>GitHub</span>
        </a>
      </nav>

      <!-- Desktop Actions -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href={siteConfig.downloads.windows.downloadUrl}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-medium text-slate-300 bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.1] hover:border-white/[0.2] transition-all duration-150"
          title="Direct Windows ZIP Download (152.2 MB)"
        >
          <Icon name="download" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          <span>Windows ZIP</span>
        </a>
        <a
          href="#download"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-600/30 transition-all duration-150"
        >
          <span>Get SIDB</span>
          <Icon name="chevron-right" size={14} class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href="#download"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500"
        >
          <span>Download</span>
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-white/[0.06] border border-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="menu" size={20} class="w-5 h-5 menu-icon-open" />
          <Icon name="x" size={20} class="w-5 h-5 menu-icon-close hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer / Dropdown -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-white/[0.08] bg-[#07080b]/95 backdrop-blur-2xl px-4 pt-3 pb-6 transition-all duration-200"
    role="region" 
    aria-label="Mobile Navigation"
  >
    <div class="flex flex-col space-y-3 text-sm font-medium">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="mobile-nav-link block px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-white/[0.05]"
        >
          {link.name}
        </a>
      ))}
      <a 
        href={siteConfig.links.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-md text-slate-300 hover:text-white hover:bg-white/[0.05]"
      >
        <span class="flex items-center gap-2">
          <Icon name="github" size={16} class="w-4 h-4 text-slate-400" />
          GitHub Repository
        </span>
        <Icon name="external-link" size={14} class="w-3.5 h-3.5 text-slate-500" />
      </a>
      
      <div class="pt-3 border-t border-white/[0.08] flex flex-col gap-2">
        <a
          href={siteConfig.downloads.windows.downloadUrl}
          class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-xs font-medium text-slate-200 bg-white/[0.05] border border-white/[0.1]"
        >
          <Icon name="download" size={14} class="w-3.5 h-3.5 text-indigo-400" />
          Windows x64 ZIP (152.2 MB)
        </a>
        <a
          href="#download"
          class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500"
        >
          All Downloads & Linux Packages
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = toggleBtn?.querySelector('.menu-icon-open');
  const closeIcon = toggleBtn?.querySelector('.menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    if (!menu || !toggleBtn) return;
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    menu.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  toggleBtn?.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (!menu?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });

  // Close with Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      toggleMenu();
    }
  });
</script>

