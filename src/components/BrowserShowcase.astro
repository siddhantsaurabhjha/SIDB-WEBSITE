---
import Icon from './Icon.astro';
import { showcaseSlides } from '../data/features';
---

<section id="showcase" class="py-20 md:py-32 border-t border-white/[0.08] relative">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 md:mb-24">
      <div class="badge-neutral mb-3">Authentic Product Showcase</div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        A Closer Look at the SIDB Interface
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300/90 leading-relaxed">
        Every pixel shown below is captured directly from running SIDB v0.1.0 builds. No conceptual mockups or simulated interfaces.
      </p>
    </div>

    <!-- Alternating Showcase Slides -->
    <div class="space-y-24 md:space-y-36">
      {showcaseSlides.map((slide, index) => {
        const isReversed = index % 2 === 1;
        return (
          <div class={`grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center ${isReversed ? 'lg:grid-flow-dense' : ''}`}>
            
            <!-- Description / Highlights Column -->
            <div class={`lg:col-span-5 space-y-6 ${isReversed ? 'lg:col-start-8' : ''}`}>
              <div>
                <span class="text-xs uppercase font-mono tracking-wider text-violet-400 font-medium">
                  {slide.eyebrow}
                </span>
                <h3 class="mt-2 text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
                  {slide.title}
                </h3>
              </div>

              <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed">
                {slide.description}
              </p>

              <div class="space-y-3.5 pt-2">
                {slide.highlights.map((item) => (
                  <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.07] hover:border-white/[0.14] transition-colors">
                    <h4 class="text-sm font-semibold text-white flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
                      {item.title}
                    </h4>
                    <p class="mt-1 text-xs sm:text-sm text-slate-300/80 leading-relaxed pl-3.5">
                      {item.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Large Screenshot Frame Column -->
            <div class={`lg:col-span-7 ${isReversed ? 'lg:col-start-1' : ''}`}>
              <div class="browser-frame group cursor-pointer relative transition-all duration-300 hover:border-white/25 hover:shadow-2xl" data-lightbox={slide.imageSrc}>
                
                <!-- Frame Header Bar -->
                <div class="h-9 px-3.5 bg-[#080b12] border-b border-white/[0.08] flex items-center justify-between select-none">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-white/20"></span>
                    <span class="ml-2 text-[10px] text-slate-400 font-mono">SIDB v0.1.0 • {slide.id}</span>
                  </div>
                  <div class="flex items-center gap-1 text-[11px] text-slate-400 group-hover:text-violet-300 transition-colors">
                    <span>Click to inspect</span>
                    <Icon name="external-link" size={12} class="w-3 h-3" />
                  </div>
                </div>

                <!-- Screenshot Image with natural aspect ratio -->
                <div class="relative bg-[#060709] overflow-hidden">
                  <img
                    src={slide.imageSrc}
                    alt={slide.imageAlt}
                    width={slide.width}
                    height={slide.height}
                    class="w-full h-auto object-cover block group-hover:scale-[1.008] transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                  <!-- Subtle gradient vignette -->
                  <div class="absolute inset-0 pointer-events-none ring-1 ring-inset ring-white/[0.08] rounded-b-xl"></div>
                </div>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>

  <!-- Accessible Lightbox Modal for Full Screenshot Inspection -->
  <dialog id="screenshot-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl p-4 sm:p-8 w-full h-full max-w-none max-h-none border-0 m-0 hidden flex-col items-center justify-center">
    <div class="relative max-w-7xl w-full h-full flex flex-col items-center justify-center">
      <button 
        id="close-modal-btn" 
        class="absolute top-2 right-2 sm:top-4 sm:right-4 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white focus:outline-none focus:ring-2 focus:ring-violet-500 z-10 transition-colors"
        aria-label="Close screenshot preview"
      >
        <Icon name="x" size={24} class="w-6 h-6" />
      </button>
      <div class="w-full h-full flex items-center justify-center overflow-auto p-2">
        <img id="modal-img" src="" alt="Full resolution browser screenshot" class="max-w-full max-h-[90vh] object-contain rounded-lg border border-white/10 shadow-2xl" />
      </div>
    </div>
  </dialog>

</section>

<script>
  const modal = document.getElementById('screenshot-modal') as HTMLDialogElement | null;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('close-modal-btn');
  const cards = document.querySelectorAll('[data-lightbox]');

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const src = card.getAttribute('data-lightbox');
      if (modal && modalImg && src) {
        modalImg.src = src;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
