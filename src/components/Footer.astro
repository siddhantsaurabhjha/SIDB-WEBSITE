---
import Icon from './Icon.astro';
import { siteConfig } from '../data/config';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.08] bg-[#050608] py-14 md:py-20 text-slate-400 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 pb-10 border-b border-white/[0.06]">
      
      <!-- Brand & Tagline -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg overflow-hidden bg-white/5 border border-white/10 flex items-center justify-center p-0.5">
            <img 
              src="/assets/brand/logo.png" 
              alt="SIDB Logo" 
              width="32" 
              height="32" 
              class="w-full h-full object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="text-base font-bold text-white tracking-wider">SIDB</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.04] text-slate-400 border border-white/[0.08]">
            {siteConfig.version}
          </span>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm max-w-sm">
          {siteConfig.tagline}
        </p>
      </div>

      <!-- Footer Quick Navigation -->
      <div class="flex flex-wrap items-center gap-6 sm:gap-8 text-xs font-medium text-slate-400">
        <a href="#showcase" class="hover:text-white transition-colors">Browser</a>
        <a href="#features" class="hover:text-white transition-colors">Features</a>
        <a href="#shield" class="hover:text-white transition-colors">Shield</a>
        <a href="#download" class="hover:text-white transition-colors">Downloads</a>
        <a href="#requirements" class="hover:text-white transition-colors">Requirements</a>
        <a href={siteConfig.links.userGuide} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center gap-1">
          <span>Documentation</span>
          <Icon name="external-link" size={11} class="w-3 h-3 text-slate-400" />
        </a>
        <a href={siteConfig.links.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center gap-1">
          <Icon name="github" size={14} class="w-3.5 h-3.5 text-slate-400" />
          <span>GitHub</span>
        </a>
      </div>

    </div>

    <!-- Bottom Legal / Open Source Attributions -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <p>© {currentYear} SIDB Browser. An independent open-source project.</p>
        <p class="text-[11px] text-slate-400 mt-1">
          Chromium is a trademark of Google LLC. Electron is a project of OpenJS Foundation. SIDB is not affiliated with Google or NVIDIA.
        </p>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href={siteConfig.links.releases} target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          Release v0.1.0 Assets
        </a>
        <span>•</span>
        <a href={siteConfig.links.checksums} target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          SHA256SUMS
        </a>
      </div>
    </div>

  </div>
</footer>

