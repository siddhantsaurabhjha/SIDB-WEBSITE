---
import Icon from './Icon.astro';
import { siteConfig } from '../data/config';
---

<section id="download" class="py-20 md:py-32 border-t border-white/[0.08] relative">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14">
      <div class="badge-neutral mb-3">Official Distribution</div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
        Download SIDB Browser {siteConfig.version}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-300/90 leading-relaxed">
        Standalone, portable releases verified directly from official GitHub Release assets. No installers required, no hidden telemetry, and no forced background changes.
      </p>
    </div>

    <!-- Downloads Grid: Windows Featured Card & Linux Packages -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Primary Windows Card (Featured) -->
      <div class="lg:col-span-7 glass-panel rounded-3xl p-8 sm:p-10 border-violet-500/30 flex flex-col justify-between relative overflow-hidden group glow-accent">
        
        <div class="relative z-10 space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="badge-pill">
              <Icon name="check" size={12} class="w-3 h-3 text-violet-400" />
              Windows Portable ZIP
            </span>
            <span class="text-xs font-mono text-slate-400">Release v0.1.0 • x64</span>
          </div>

          <div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-3">
              <span>Windows x64</span>
              <span class="text-xs font-mono font-normal px-2.5 py-1 rounded bg-white/[0.06] text-slate-300 border border-white/[0.1]">
                {siteConfig.downloads.windows.fileSize}
              </span>
            </h3>
            <p class="mt-2 text-sm sm:text-base text-slate-300/90 leading-relaxed">
              {siteConfig.downloads.windows.description}
            </p>
          </div>

          <!-- Quick instructions -->
          <div class="p-4 rounded-xl bg-black/50 border border-white/[0.08] text-xs text-slate-300 space-y-1.5 font-mono">
            <div class="text-slate-400 font-sans text-xs font-semibold mb-1">Installation Guide:</div>
            <div>1. Download <span class="text-violet-300 font-semibold">{siteConfig.downloads.windows.fileName}</span></div>
            <div>2. Extract ZIP to your preferred folder (e.g. <span class="text-violet-300">C:\Apps\SIDB</span>)</div>
            <div>3. Launch <span class="text-emerald-400 font-semibold">SIDB.exe</span> directly (no setup installer needed)</div>
          </div>

          <!-- Download Action -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href={siteConfig.downloads.windows.downloadUrl}
              class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-xl text-sm font-semibold text-white bg-violet-600 hover:bg-violet-500 shadow-xl shadow-violet-600/30 border border-violet-400/40 transition-all duration-150 group"
            >
              <Icon name="download" size={18} class="w-4 h-4 text-white group-hover:-translate-y-0.5 transition-transform" />
              <span>Download Windows ZIP (152.2 MB)</span>
            </a>

            <a
              href={siteConfig.links.checksums}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-4 rounded-xl text-xs font-medium text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] transition-colors"
            >
              <Icon name="terminal" size={14} class="w-3.5 h-3.5 text-slate-400" />
              <span>SHA256 Checksums</span>
            </a>
          </div>
        </div>

        <!-- System Compatibility Footer -->
        <div class="mt-8 pt-5 border-t border-white/[0.08] flex items-center justify-between text-xs text-slate-400">
          <span>Compatible with Windows 10 & 11 (64-bit)</span>
          <span class="text-slate-500">Standalone Portable • No Admin Required</span>
        </div>

      </div>

      <!-- Linux Packages Card -->
      <div class="lg:col-span-5 glass-card rounded-3xl p-8 sm:p-10 flex flex-col justify-between">
        
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="badge-neutral">Linux Distributions</span>
            <span class="text-xs font-mono text-slate-400">x86_64</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Official Linux Packages
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-slate-300/80 leading-relaxed">
            Native package manager builds verified on modern distributions with standard graphics acceleration.
          </p>

          <!-- Linux Package Options -->
          <div class="mt-6 space-y-3">
            
            <!-- Ubuntu / Debian -->
            <a
              href={siteConfig.downloads.linuxDeb.downloadUrl}
              class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.07] hover:border-violet-500/40 transition-all group"
            >
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-violet-300 transition-colors">
                  Linux DEB (Debian / Ubuntu / Mint)
                </div>
                <div class="text-xs text-slate-400 font-mono mt-0.5">
                  {siteConfig.downloads.linuxDeb.fileName}
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
                <span>{siteConfig.downloads.linuxDeb.fileSize}</span>
                <Icon name="download" size={14} class="w-3.5 h-3.5 text-violet-400" />
              </div>
            </a>

            <!-- Fedora / RPM -->
            <a
              href={siteConfig.downloads.linuxRpm.downloadUrl}
              class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.07] hover:border-violet-500/40 transition-all group"
            >
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-violet-300 transition-colors">
                  Linux RPM (Fedora / RHEL / openSUSE)
                </div>
                <div class="text-xs text-slate-400 font-mono mt-0.5">
                  {siteConfig.downloads.linuxRpm.fileName}
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
                <span>{siteConfig.downloads.linuxRpm.fileSize}</span>
                <Icon name="download" size={14} class="w-3.5 h-3.5 text-violet-400" />
              </div>
            </a>

            <!-- Portable Linux ZIP -->
            <a
              href={siteConfig.downloads.linuxZip.downloadUrl}
              class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.07] hover:border-violet-500/40 transition-all group"
            >
              <div>
                <div class="text-sm font-semibold text-white group-hover:text-violet-300 transition-colors">
                  Linux Portable ZIP (Arch / Alpine / Others)
                </div>
                <div class="text-xs text-slate-400 font-mono mt-0.5">
                  {siteConfig.downloads.linuxZip.fileName}
                </div>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-400 font-mono">
                <span>{siteConfig.downloads.linuxZip.fileSize}</span>
                <Icon name="download" size={14} class="w-3.5 h-3.5 text-violet-400" />
              </div>
            </a>

          </div>
        </div>

        <!-- Release Notes link -->
        <div class="mt-8 pt-5 border-t border-white/[0.08] flex items-center justify-between text-xs">
          <a
            href={siteConfig.links.latestRelease}
            target="_blank"
            rel="noopener noreferrer"
            class="text-violet-400 hover:text-violet-300 inline-flex items-center gap-1 transition-colors"
          >
            <span>View release tag on GitHub</span>
            <Icon name="external-link" size={12} class="w-3 h-3" />
          </a>
          <span class="text-slate-400 font-mono">glibc 2.35+</span>
        </div>

      </div>

    </div>

    <!-- Transparent Release Notes & Verification Box -->
    <div class="mt-12 rounded-3xl bg-white/[0.02] border border-white/[0.08] p-6 sm:p-10 space-y-8">
      
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <Icon name="info" size={20} class="w-5 h-5 text-violet-400" />
          <span>Release v0.1.0 Notes & Transparency</span>
        </h3>
        <p class="mt-1.5 text-sm text-slate-300/80">
          We believe in direct honesty about what is implemented today and what to expect during initial installation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {siteConfig.limitations.map((item) => (
          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2">
            <h4 class="text-sm font-semibold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              {item.title}
            </h4>
            <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      <!-- SHA256 Verification Command Snippet with Interactive Copy Buttons -->
      <div class="pt-2 border-t border-white/[0.06]">
        <div class="text-xs font-semibold text-slate-300 mb-2 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <Icon name="terminal" size={14} class="w-3.5 h-3.5 text-violet-400" />
            <span>Verify SHA256 Checksums Locally:</span>
          </span>
          <span class="text-[11px] text-slate-400">Click to copy command</span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs font-mono">
          
          <div class="relative group p-3.5 rounded-xl bg-black/60 border border-white/[0.08] text-slate-300 overflow-x-auto flex items-center justify-between gap-2">
            <div class="select-all">
              <span class="text-slate-500 font-sans text-[11px] block mb-0.5">Windows PowerShell:</span>
              <code id="win-cmd">Get-FileHash .\SIDB-0.1.0-win-x64.zip -Algorithm SHA256</code>
            </div>
            <button
              type="button"
              class="copy-btn shrink-0 p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
              data-copy="Get-FileHash .\SIDB-0.1.0-win-x64.zip -Algorithm SHA256"
              aria-label="Copy Windows checksum command"
              title="Copy command"
            >
              <Icon name="copy" size={14} class="w-3.5 h-3.5 copy-icon" />
              <Icon name="check" size={14} class="w-3.5 h-3.5 check-icon hidden text-emerald-400" />
            </button>
          </div>

          <div class="relative group p-3.5 rounded-xl bg-black/60 border border-white/[0.08] text-slate-300 overflow-x-auto flex items-center justify-between gap-2">
            <div class="select-all">
              <span class="text-slate-500 font-sans text-[11px] block mb-0.5">Linux Terminal:</span>
              <code id="linux-cmd">sha256sum -c --ignore-missing SHA256SUMS.txt</code>
            </div>
            <button
              type="button"
              class="copy-btn shrink-0 p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white transition-colors"
              data-copy="sha256sum -c --ignore-missing SHA256SUMS.txt"
              aria-label="Copy Linux checksum command"
              title="Copy command"
            >
              <Icon name="copy" size={14} class="w-3.5 h-3.5 copy-icon" />
              <Icon name="check" size={14} class="w-3.5 h-3.5 check-icon hidden text-emerald-400" />
            </button>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll('.copy-btn');
  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
        }, 2000);
      }
    });
  });
</script>
